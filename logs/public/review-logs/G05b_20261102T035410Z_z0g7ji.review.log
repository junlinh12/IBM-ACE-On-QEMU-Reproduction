hypervisor/rootfs/common.sh:7:
hypervisor/rootfs/common.sh:8:function kill_confidential_vm() {
hypervisor/rootfs/common.sh:9:    PID="$(pidof qemu-system-riscv64)"
hypervisor/rootfs/common.sh:10:    kill -9 $PID
hypervisor/rootfs/common.sh:11:    wait $PID 2>/dev/null
hypervisor/rootfs/common.sh:12:}
hypervisor/rootfs/common.sh:13:
hypervisor/rootfs/common.sh:14:function wait_for_ssh () {
hypervisor/rootfs/common.sh:15:    for i in $(seq 1 30); do
hypervisor/rootfs/common.sh:16:        if [ "$( $SSH_CMD -p$3 $1@$2 'whoami' )" == "root" ]; then
hypervisor/rootfs/common.sh:17:            break
hypervisor/rootfs/common.sh:18:        fi
hypervisor/rootfs/common.sh:19:        echo "Waiting for the TVM's SSH ..."
hypervisor/rootfs/common.sh:20:        sleep 1
hypervisor/rootfs/common.sh:21:    done
hypervisor/rootfs/common.sh:22:}
