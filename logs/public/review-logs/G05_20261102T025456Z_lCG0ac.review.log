hypervisor/Makefile:74:kvmtool:
hypervisor/Makefile:75:	mkdir -p $(KVMTOOL_WORK_DIR) && cd $(KVMTOOL_WORK_DIR) ;\
hypervisor/Makefile:76:    if [ ! -f "${KVMTOOL_WORK_DIR}/dtc/build/libfdt.so" ]; then \
hypervisor/Makefile:77:        rm -rf ${KVMTOOL_WORK_DIR}/dtc ;\
hypervisor/Makefile:78:        git clone git://git.kernel.org/pub/scm/utils/dtc/dtc.git ;\
hypervisor/Makefile:79:        cd dtc ;\
hypervisor/Makefile:80:        ARCH=riscv CC="${CROSS_COMPILE}gcc -mabi=${PLATFORM_RISCV_ABI} -march=${PLATFORM_RISCV_ISA}" make NO_PYTHON=1 NO_YAML=1 DESTDIR=$($CC -print-sysroot) PREFIX=${KVMTOOL_WORK_DIR}/dtc/build LIBDIR=${KVMTOOL_WORK_DIR}/dtc/build/$($CC -dumpmachine) install-lib install-includes ;\
hypervisor/Makefile:81:        cp ${KVMTOOL_WORK_DIR}/dtc/build/include/* ${KVMTOOL_WORK_DIR}/dtc/build/ ;\
hypervisor/Makefile:82:        cd .. ;\
hypervisor/Makefile:83:    fi ;\
hypervisor/Makefile:84:	if [ ! -f "${KVMTOOL_WORK_DIR}/kvmtool/lkvm-static" ]; then \
hypervisor/Makefile:85:		rm -rf ${KVMTOOL_WORK_DIR}/kvmtool ;\
hypervisor/Makefile:86:		git clone -b cove-integration-03072023 https://github.com/wojciechozga/kvmtool.git ;\
hypervisor/Makefile:87:		rm -f $(KVMTOOL_WORK_DIR)/kvmtool/lkvm-static ;\
hypervisor/Makefile:88:		cd $(KVMTOOL_WORK_DIR)/kvmtool ;\
hypervisor/Makefile:89:		ARCH=riscv LIBFDT_DIR=${KVMTOOL_WORK_DIR}/dtc/build/ make lkvm-static -j$(nproc) ;\
hypervisor/Makefile:90:		${CROSS_COMPILE}strip lkvm-static ;\
hypervisor/Makefile:91:		cd .. ;\
hypervisor/Makefile:92:	fi
