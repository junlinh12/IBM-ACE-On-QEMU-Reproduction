tools/ace_run_hypervisor.sh:1:#!/usr/bin/env bash
tools/ace_run_hypervisor.sh:2:# SPDX-FileCopyrightText: 2023 IBM Corporation
tools/ace_run_hypervisor.sh:3:# SPDX-FileContributor: Wojciech Ozga <woz@zurich.ibm.com>, IBM Research - Zurich
tools/ace_run_hypervisor.sh:4:# SPDX-License-Identifier: Apache-2.0
tools/ace_run_hypervisor.sh:5:
tools/ace_run_hypervisor.sh:6:if [ -z ${ACE_DIR} ]; then
tools/ace_run_hypervisor.sh:7:    echo "ACE_DIR must point to the directory where ACE is installed"
tools/ace_run_hypervisor.sh:8:    exit 1
tools/ace_run_hypervisor.sh:9:fi
tools/ace_run_hypervisor.sh:10:
tools/ace_run_hypervisor.sh:11:QEMU_CMD=${ACE_DIR}/qemu/bin/qemu-system-riscv64
tools/ace_run_hypervisor.sh:12:KERNEL=${ACE_DIR}/security-monitor/opensbi/platform/generic/firmware/fw_payload.elf
tools/ace_run_hypervisor.sh:13:DRIVE=${ACE_DIR}/hypervisor/buildroot/images/rootfs.ext4
tools/ace_run_hypervisor.sh:14:
tools/ace_run_hypervisor.sh:15:HOST_PORT="$((3000 + RANDOM % 3000))"
tools/ace_run_hypervisor.sh:16:INTERACTIVE="-nographic"
tools/ace_run_hypervisor.sh:17:SMP=4
tools/ace_run_hypervisor.sh:18:MEMORY=4G
tools/ace_run_hypervisor.sh:19:
tools/ace_run_hypervisor.sh:20:for i in "$@"; do
tools/ace_run_hypervisor.sh:21:  case $i in
tools/ace_run_hypervisor.sh:22:    -e=*|--debug-port=*)
tools/ace_run_hypervisor.sh:23:      DEBUG_PORT="${i#*=}"
tools/ace_run_hypervisor.sh:24:      DEBUG_OPTIONS="-gdb tcp::${DEBUG_PORT} -S -d in_asm -D debug.log"
tools/ace_run_hypervisor.sh:25:      echo ${DEBUG_OPTIONS}
tools/ace_run_hypervisor.sh:26:      shift
tools/ace_run_hypervisor.sh:27:      ;;
tools/ace_run_hypervisor.sh:28:    --host-port=*)
tools/ace_run_hypervisor.sh:29:      HOST_PORT="${i#*=}"
tools/ace_run_hypervisor.sh:30:      shift
tools/ace_run_hypervisor.sh:31:      ;;
tools/ace_run_hypervisor.sh:32:    -s=*|--smp=*)
tools/ace_run_hypervisor.sh:33:      SMP="${i#*=}"
tools/ace_run_hypervisor.sh:34:      shift
tools/ace_run_hypervisor.sh:35:      ;;
tools/ace_run_hypervisor.sh:36:    -m=*|--memory=*)
tools/ace_run_hypervisor.sh:37:      MEMORY="${i#*=}"
tools/ace_run_hypervisor.sh:38:      shift
tools/ace_run_hypervisor.sh:39:      ;;
tools/ace_run_hypervisor.sh:40:    --daemonize*)
tools/ace_run_hypervisor.sh:41:      INTERACTIVE="-daemonize"
tools/ace_run_hypervisor.sh:42:      shift
tools/ace_run_hypervisor.sh:43:      ;;
tools/ace_run_hypervisor.sh:44:    -*|--*)
tools/ace_run_hypervisor.sh:45:      echo "Unknown option $i"
tools/ace_run_hypervisor.sh:46:      exit 1
tools/ace_run_hypervisor.sh:47:      ;;
tools/ace_run_hypervisor.sh:48:    *)
tools/ace_run_hypervisor.sh:49:      ;;
tools/ace_run_hypervisor.sh:50:  esac
tools/ace_run_hypervisor.sh:51:done
tools/ace_run_hypervisor.sh:52:
tools/ace_run_hypervisor.sh:53:echo "SSH port: ${HOST_PORT}"
tools/ace_run_hypervisor.sh:54:echo "Number of cores assigned to the guest: ${SMP}"
tools/ace_run_hypervisor.sh:55:
tools/ace_run_hypervisor.sh:56:${QEMU_CMD} ${DEBUG_OPTIONS} \
tools/ace_run_hypervisor.sh:57:    -m ${MEMORY} \
tools/ace_run_hypervisor.sh:58:    ${INTERACTIVE} \
tools/ace_run_hypervisor.sh:59:    -machine virt -cpu rv64 \
tools/ace_run_hypervisor.sh:60:    -bios none \
tools/ace_run_hypervisor.sh:61:    -kernel ${KERNEL} \
tools/ace_run_hypervisor.sh:62:    -global virtio-mmio.force-legacy=false \
tools/ace_run_hypervisor.sh:63:    -append "console=ttyS0 ro root=/dev/vda" \
tools/ace_run_hypervisor.sh:64:    -drive if=none,format=raw,file=${DRIVE},id=hd0 \
tools/ace_run_hypervisor.sh:65:    -device virtio-blk-device,scsi=off,drive=hd0 \
tools/ace_run_hypervisor.sh:66:    -netdev user,id=net0,net=192.168.100.1/24,dhcpstart=192.168.100.128,hostfwd=tcp::${HOST_PORT}-:22 \
tools/ace_run_hypervisor.sh:67:    -device virtio-net-device,netdev=net0 \
tools/ace_run_hypervisor.sh:68:    -device virtio-rng-pci \
tools/ace_run_hypervisor.sh:69:    -smp ${SMP}
tools/ace_start.sh:1:#!/usr/bin/env bash
tools/ace_start.sh:2:# SPDX-FileCopyrightText: 2023 IBM Corporation
tools/ace_start.sh:3:# SPDX-FileContributor: Wojciech Ozga <woz@zurich.ibm.com>, IBM Research - Zurich
tools/ace_start.sh:4:# SPDX-License-Identifier: Apache-2.0
tools/ace_start.sh:5:
tools/ace_start.sh:6:if [ -z ${ACE_DIR} ]; then
tools/ace_start.sh:7:    echo "ACE_DIR must point to the directory where ACE is installed"
tools/ace_start.sh:8:    exit 1
tools/ace_start.sh:9:fi
tools/ace_start.sh:10:
tools/ace_start.sh:11:# load common configuration
tools/ace_start.sh:12:. ${ACE_DIR}/tools/common.sh
tools/ace_start.sh:13:
tools/ace_start.sh:14:# start the VM
tools/ace_start.sh:15:${ACE_DIR}/tools/ace_run_hypervisor.sh --daemonize > .run_tests.log
tools/ace_start.sh:16:
tools/ace_start.sh:17:# find out on which port its ssh server is listening
tools/ace_start.sh:18:HYPERVISOR_TEST_PORT="$(grep 'SSH port' .run_tests.log | awk -F': ' '{ print $2 }' )"
tools/ace_start.sh:19:echo "Hypervisor's SSH is listening on port: $HYPERVISOR_TEST_PORT"
tools/ace_start.sh:20:
tools/ace_start.sh:21:# wait until the VM is up and running
tools/ace_start.sh:22:wait_for_ssh ${HYPERVISOR_TEST_LOGIN} ${HYPERVISOR_TEST_HOSTNAME} ${HYPERVISOR_TEST_PORT}
tools/ace_start.sh:23:
tools/ace_start.sh:24:# execute tests remotely over ssh
tools/ace_start.sh:25:${SSH_CMD} -p${HYPERVISOR_TEST_PORT} ${HYPERVISOR_TEST_LOGIN}@${HYPERVISOR_TEST_HOSTNAME}
tools/ace_start.sh:26:
tools/ace_start.sh:27:# kill the VM
tools/ace_start.sh:28:kill_qemu ${HYPERVISOR_TEST_PORT}
