security-monitor/Makefile:32:	mkdir -p $(SM_WORK_DIR) ; \
security-monitor/Makefile:33:	rm -f $(SM_WORK_DIR)/$(CHAIN)/release/$(EXEC_NAME); \
security-monitor/Makefile:34:	RUSTFLAGS='$(RUSTFLAGS)' CARGO_TARGET_DIR=$(SM_WORK_DIR) INSTALL_DIR=$(ACE_DIR) $(CARGO) build $(RELEASE) $(TARGET) --features verbose ; \
security-monitor/Makefile:35:	cp $(SM_WORK_DIR)/$(CHAIN)/release/$(EXEC_NAME) $(SM_WORK_DIR)/ ; \
security-monitor/Makefile:36:	rm -rf $(OPENSBI_WORK_DIR)/
