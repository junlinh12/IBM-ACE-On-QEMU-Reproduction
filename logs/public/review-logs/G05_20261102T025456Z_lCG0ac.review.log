security-monitor/platform/generic/objects.mk:1:#
security-monitor/platform/generic/objects.mk:2:# SPDX-License-Identifier: BSD-2-Clause
security-monitor/platform/generic/objects.mk:3:#
security-monitor/platform/generic/objects.mk:4:# Copyright (c) 2020 Western Digital Corporation or its affiliates.
security-monitor/platform/generic/objects.mk:5:#
security-monitor/platform/generic/objects.mk:6:# Authors:
security-monitor/platform/generic/objects.mk:7:#   Anup Patel <anup.patel@wdc.com>
security-monitor/platform/generic/objects.mk:8:#
security-monitor/platform/generic/objects.mk:9:
security-monitor/platform/generic/objects.mk:10:# Compiler flags
security-monitor/platform/generic/objects.mk:11:platform-cppflags-y =
security-monitor/platform/generic/objects.mk:12:platform-cflags-y =
security-monitor/platform/generic/objects.mk:13:platform-asflags-y =
security-monitor/platform/generic/objects.mk:14:platform-ldflags-y = -L$(SM_WORK_DIR) -lace
security-monitor/platform/generic/objects.mk:15:
security-monitor/platform/generic/objects.mk:16:# Command for platform specific "make run"
security-monitor/platform/generic/objects.mk:17:platform-runcmd = qemu-system-riscv$(PLATFORM_RISCV_XLEN) -M virt -m 256M \
security-monitor/platform/generic/objects.mk:18:  -nographic -bios $(build_dir)/platform/generic/firmware/fw_payload.elf
security-monitor/platform/generic/objects.mk:19:
security-monitor/platform/generic/objects.mk:20:# Objects to build
security-monitor/platform/generic/objects.mk:21:platform-objs-y += platform.o
security-monitor/platform/generic/objects.mk:22:platform-objs-y += platform_override_modules.o
security-monitor/platform/generic/objects.mk:23:
security-monitor/platform/generic/objects.mk:24:# Blobs to build
security-monitor/platform/generic/objects.mk:25:FW_TEXT_START=0x80000000
security-monitor/platform/generic/objects.mk:26:FW_DYNAMIC=y
security-monitor/platform/generic/objects.mk:27:FW_JUMP=y
security-monitor/platform/generic/objects.mk:28:ifeq ($(PLATFORM_RISCV_XLEN), 32)
security-monitor/platform/generic/objects.mk:29:  # This needs to be 4MB aligned for 32-bit system
security-monitor/platform/generic/objects.mk:30:  FW_JUMP_ADDR=$(shell printf "0x%X" $$(($(FW_TEXT_START) + 0x400000)))
security-monitor/platform/generic/objects.mk:31:else
security-monitor/platform/generic/objects.mk:32:  # This needs to be 2MB aligned for 64-bit system
security-monitor/platform/generic/objects.mk:33:  FW_JUMP_ADDR=$(shell printf "0x%X" $$(($(FW_TEXT_START) + 0x200000)))
security-monitor/platform/generic/objects.mk:34:endif
security-monitor/platform/generic/objects.mk:35:FW_JUMP_FDT_ADDR=$(shell printf "0x%X" $$(($(FW_TEXT_START) + 0x2200000)))
security-monitor/platform/generic/objects.mk:36:FW_PAYLOAD=y
security-monitor/platform/generic/objects.mk:37:ifeq ($(PLATFORM_RISCV_XLEN), 32)
security-monitor/platform/generic/objects.mk:38:  # This needs to be 4MB aligned for 32-bit system
security-monitor/platform/generic/objects.mk:39:  FW_PAYLOAD_OFFSET=0x400000
security-monitor/platform/generic/objects.mk:40:else
security-monitor/platform/generic/objects.mk:41:  # This needs to be 2MB aligned for 64-bit system
security-monitor/platform/generic/objects.mk:42:  FW_PAYLOAD_OFFSET=0x200000
security-monitor/platform/generic/objects.mk:43:endif
security-monitor/platform/generic/objects.mk:44:FW_PAYLOAD_FDT_ADDR=$(FW_JUMP_FDT_ADDR)
