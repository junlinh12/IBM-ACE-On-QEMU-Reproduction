tools/ace:4:# SPDX-License-Identifier: Apache-2.0
tools/ace:5:
tools/ace:6:if [ -z ${ACE_DIR} ]; then
tools/ace:7:    echo "ACE_DIR must point to the directory where ACE is installed"
tools/ace:8:    exit 1
tools/ace:9:fi
tools/ace:10:
tools/ace:11:if [ "$1" == "test" ]; then
tools/ace:12:    ${ACE_DIR}/tools/ace_test.sh
tools/ace:13:elif [ "$1" == "start" ]; then
tools/ace:14:    ${ACE_DIR}/tools/ace_start.sh $@
tools/ace:15:elif [ "$1" == "stop" ]; then
tools/ace:16:    ${ACE_DIR}/tools/ace_stop.sh
tools/ace:17:elif [ "$1" == "connect" ]; then
tools/ace:18:    ${ACE_DIR}/tools/ace_connect.sh $@
tools/ace:19:elif [ "$1" == "run" ]; then
tools/ace:20:    ${ACE_DIR}/tools/ace_run_hypervisor.sh $@
tools/ace:21:else
tools/ace:22:    echo "Usage: ./ace [start|stop|connect|test]"
tools/ace:23:fi
