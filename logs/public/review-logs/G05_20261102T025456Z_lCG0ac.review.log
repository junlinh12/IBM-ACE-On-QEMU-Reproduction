tools/ace_test.sh:1:#!/usr/bin/env bash
tools/ace_test.sh:2:# SPDX-FileCopyrightText: 2023 IBM Corporation
tools/ace_test.sh:3:# SPDX-FileContributor: Wojciech Ozga <woz@zurich.ibm.com>, IBM Research - Zurich
tools/ace_test.sh:4:# SPDX-License-Identifier: Apache-2.0
tools/ace_test.sh:5:
tools/ace_test.sh:6:if [ -z ${ACE_DIR} ]; then
tools/ace_test.sh:7:    echo "ACE_DIR must point to the directory where ACE is installed"
tools/ace_test.sh:8:    exit 1
tools/ace_test.sh:9:fi
tools/ace_test.sh:10:
tools/ace_test.sh:11:# load common configuration
tools/ace_test.sh:12:. ${ACE_DIR}/tools/common.sh
tools/ace_test.sh:13:
tools/ace_test.sh:14:# start the VM
tools/ace_test.sh:15:${ACE_DIR}/tools/ace_run_hypervisor.sh --daemonize > .run_tests.log
tools/ace_test.sh:16:
tools/ace_test.sh:17:# find out on which port its ssh server is listening
tools/ace_test.sh:18:HYPERVISOR_TEST_PORT="$(grep 'SSH port' .run_tests.log | awk -F': ' '{ print $2 }' )"
tools/ace_test.sh:19:echo "Hypervisor's SSH is listening on port: $HYPERVISOR_TEST_PORT"
tools/ace_test.sh:20:
tools/ace_test.sh:21:# wait until the VM is up and running
tools/ace_test.sh:22:wait_for_ssh ${HYPERVISOR_TEST_LOGIN} ${HYPERVISOR_TEST_HOSTNAME} ${HYPERVISOR_TEST_PORT}
tools/ace_test.sh:23:
tools/ace_test.sh:24:# execute tests remotely over ssh
tools/ace_test.sh:25:${SSH_CMD} -p${HYPERVISOR_TEST_PORT} ${HYPERVISOR_TEST_LOGIN}@${HYPERVISOR_TEST_HOSTNAME} './selftest.sh' > ace_test_results
tools/ace_test.sh:26:
tools/ace_test.sh:27:# kill the VM
tools/ace_test.sh:28:kill_qemu ${HYPERVISOR_TEST_PORT}
tools/ace_test.sh:29:
tools/ace_test.sh:30:FAILED="$( grep ': failed' ace_test_results | wc -l)"
tools/ace_test.sh:31:cat ace_test_results
tools/ace_test.sh:32:
tools/ace_test.sh:33:if [[ $FAILED -gt 0 ]]; then
tools/ace_test.sh:34:    exit 1
tools/ace_test.sh:35:fi
tools/ace_test.sh:36:exit 0
tools/common.sh:1:#!/usr/bin/env bash
tools/common.sh:2:# SPDX-FileCopyrightText: 2023 IBM Corporation
tools/common.sh:3:# SPDX-FileContributor: Wojciech Ozga <woz@zurich.ibm.com>, IBM Research - Zurich
tools/common.sh:4:# SPDX-License-Identifier: Apache-2.0
tools/common.sh:5:
tools/common.sh:6:# ssh utilities
tools/common.sh:7:export HYPERVISOR_TEST_LOGIN="root"
tools/common.sh:8:export HYPERVISOR_TEST_PASSWD="passwd"
tools/common.sh:9:export HYPERVISOR_TEST_HOSTNAME="localhost"
tools/common.sh:10:
tools/common.sh:11:export SSH_PASSWD_PARAMS="-o PasswordAuthentication=yes -o PreferredAuthentications=keyboard-interactive,password -o PubkeyAuthentication=no -o StrictHostKeyChecking=no"
tools/common.sh:12:export SSH_CMD="sshpass -p ${HYPERVISOR_TEST_PASSWD} ssh ${SSH_PASSWD_PARAMS}"
tools/common.sh:13:
tools/common.sh:14:# Usage: wait_for_ssh "root", "localhost", "22"
tools/common.sh:15:function wait_for_ssh () {
tools/common.sh:16:    while [ "$( $SSH_CMD -p$3 $1@$2 'whoami' )" != "root" ]; do
tools/common.sh:17:        echo "waiting for the hypervisor's ssh ..."
tools/common.sh:18:        sleep 1
tools/common.sh:19:    done
tools/common.sh:20:}
tools/common.sh:21:
tools/common.sh:22:function kill_users_qemu () {
tools/common.sh:23:    USER="$(whoami)"
tools/common.sh:24:    PID="$(ps aux | grep qemu | grep ${USER} | awk -F' ' '{ print $2  }')"
tools/common.sh:25:    if [ "$PID" != "" ]; then
tools/common.sh:26:        kill -9 $PID
tools/common.sh:27:        wait $PID 2>/dev/null
tools/common.sh:28:    fi
tools/common.sh:29:}
tools/common.sh:30:
tools/common.sh:31:# Usage: kill_qemu "22"
tools/common.sh:32:function kill_qemu () {
tools/common.sh:33:    PORT=$1
tools/common.sh:34:    PID="$(ps aux | grep qemu | grep ${PORT} | awk -F' ' '{ print $2  }')"
tools/common.sh:35:    if [ "$PID" != "" ]; then
tools/common.sh:36:        kill -9 $PID
tools/common.sh:37:        wait $PID 2>/dev/null
tools/common.sh:38:    fi
tools/common.sh:39:}
