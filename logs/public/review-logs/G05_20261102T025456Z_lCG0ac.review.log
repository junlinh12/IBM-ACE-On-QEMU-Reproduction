security-monitor/Makefile:22:
security-monitor/Makefile:23:PLATFORM_RISCV_ABI ?= lp64d
security-monitor/Makefile:24:PLATFORM_RISCV_ISA ?= rv64gc
security-monitor/Makefile:25:PLATFORM_RISCV_XLEN ?= 64
security-monitor/Makefile:26:CROSS_COMPILE ?= riscv64-unknown-linux-gnu-
