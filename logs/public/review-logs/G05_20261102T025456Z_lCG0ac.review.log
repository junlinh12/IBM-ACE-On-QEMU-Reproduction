security-monitor/Makefile:11:MAKEFILE_PATH := $(abspath $(lastword $(MAKEFILE_LIST)))
security-monitor/Makefile:12:MAKEFILE_SOURCE_DIR := $(dir $(realpath $(lastword $(MAKEFILE_LIST))))
security-monitor/Makefile:13:
